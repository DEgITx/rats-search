<RCC>
    <qresource prefix="/">
        <file>images/rat-logo.png</file>
        <file>images/icon.png</file>
        <file>images/checkmark.svg</file>
        <file>images/chevron-down-l.svg</file>
        <file>images/chevron-down-d.svg</file>
        <file>images/chevron-up-l.svg</file>
        <file>images/chevron-up-d.svg</file>
        <file>images/chevron-right-l.svg</file>
        <file>images/chevron-right-d.svg</file>
        <file>icon.ico</file>
        <file alias="AGREEMENT.md">../AGREEMENT.md</file>
        <file alias="CHANGELOG.md">../CHANGELOG.md</file>
    </qresource>
    <qresource prefix="/styles">
        <file>styles/theme.qss</file>
        <file>styles/light.json</file>
        <file>styles/dark.json</file>
    </qresource>
    <qresource prefix="/content">
        <file alias="extensions.json">content/extensions.json</file>
        <file alias="badwords.json">content/badwords.json</file>
    </qresource>
    <qresource prefix="/update">
        <file alias="windows_updater.bat.in">update/windows_updater.bat.in</file>
        <file alias="unix_updater.sh.in">update/unix_updater.sh.in</file>
    </qresource>
    <qresource prefix="/ts">
        <file alias="ru">../translations/ratssearch_ru.ts</file>
        <file alias="de">../translations/ratssearch_de.ts</file>
        <file alias="es">../translations/ratssearch_es.ts</file>
        <file alias="fr">../translations/ratssearch_fr.ts</file>
        <file alias="ja">../translations/ratssearch_ja.ts</file>
        <file alias="zh">../translations/ratssearch_zh.ts</file>
        <file alias="ko">../translations/ratssearch_ko.ts</file>
    </qresource>
</RCC>

